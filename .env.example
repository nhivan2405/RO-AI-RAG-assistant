GEMINI_API_KEY=YOUR_API_KEY_HERE
# Verify model availability in Google AI Studio before running
GEMINI_MODEL=gemini-3.1-flash-lite-preview
# Docker dùng http://localhost; Cloud phải dùng endpoint HTTPS của cluster.
QDRANT_URL=http://localhost:6333
# Bắt buộc cho Qdrant Cloud và tùy chọn cho Docker có xác thực.
QDRANT_API_KEY=YOUR_QDRANT_API_KEY_HERE
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=5
